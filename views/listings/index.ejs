<% layout("layouts/boillerplate") %> 

    <body>
        <h2>All listings</h2>

        <div class="row">
            <% for(let listing of listings) { %>

                <div class="col-lg-3 col-md-4 col-sm-6">
                    <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
                        <div class="card">
                            <img src="<%= listing.image %>" class="card-img-top" />
                           <div class="card-img-overlay"></div>
                            <div class="card-body">
                                <p class="card-text">
                                    <b>
                                        <%= listing.title %>
                                    </b><br>
                                    &#8377; <%= listing.price %> / night
                                </p>
                            </div>
                        </div>
                    </a>
                </div>

                <% } %>
        </div>


        <!-- <ul>
                    <% for (let listing of listings) { %>
                        <li> <a href="/listings/<%= listing._id %>">
                                <%= listing.title %>
                            </a></li>
                        <% } %>
                </ul> -->
    </body>

    </html>