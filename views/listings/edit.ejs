<% layout("layouts/boillerplate") %>
    <div class="row">
        <div class="col-8 offset-2">
       
            <h2>Edit your listing</h2>
            <form method="POST" action="/listings/<%= listing._id %>?_method=PUT"
                novalidate class="needs-validation">
                <div>
                    <label for="title" class="form-label">Title</label>

                    <input class="form-control" name="listing[title]" value="<%= listing.title %>"
                        placeholder="enter title" required>
                </div>
                <br></br>
                <div>
                    <label for="description" class="form-label">Description</label>
                    <input class="form-control" name="listing[description]" value="<%= listing.description %>"
                        placeholder="enter description" required>
                </div>
                <br></br>
                <div>
                    <label for="image" class="form-label">Image URL</label>
                    <input class="form-control" name="listing[image]" value="<%= listing.image %>"
                        placeholder="enter image url" required>
                </div>
                <br></br>
                <div>
                    <label for="price" class="form-label">Price</label>
                    <input class="form-control" name="listing[price]" value="<%= listing.price %>"
                        placeholder="enter price" required>
                </div>
                <br></br>
                <div>
                    <label for="location" class="form-label">Location</label>
                    <input class="form-control" name="listing[location]" value="<%= listing.location %>"
                        placeholder="enter location" required>
                </div>
                <br></br>
                <div>
                    <label for="country" class="form-label">Country</label>
                    <input class="form-control" name="listing[country]" value="<%= listing.country %>"
                        placeholder="enter country" required>
                </div>
                <br></br>
                <button type="submit" class="btn-edit mt-3">edit</button>
            </form>
       
        </div>
    </div>
    <script src="/js/script.js"></script>

</body>