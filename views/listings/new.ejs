<% layout("layouts/boillerplate") %>

    <body>
        <div class="col-8 offset-3">
            <br></br>
            <h2>Create New Listing</h2>
            <form method="POST" action="/listings" novalidate class="needs-validation">

                <div class="mb-3 ">
                    <label for="title" class="form-label">Title</label>
                    <input name="listing[title]" placeholder="enter title" class="form-control" required >
                </div>
                <br>
                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <input name="listing[description]" placeholder="enter description" class="form-control"required>
                </div>
                <br>
                <div class="mb-3">
                    <label for="image" class="form-label">Image URL</label>
                    <input name="listing[image]" placeholder="enter image url" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label for="price" class="form-label">Price</label>
                    <input name="listing[price]" placeholder="enter price" class="form-control" required>
                </div>
                <br>
                <div class="mb-3">
                    <label for="location" class="form-label">Location</label>
                    <input name="listing[location]" placeholder="enter location" class="form-control" required>
                </div>
                <br>
                <div class="mb-3">
                    <label for="country" class="form-label">Country</label>
                    <input name="listing[country]" placeholder="enter country" class="form-control" required>
                </div>
                <br>
                <button type="submit" class="btn-add">Add</button>

            </form>
        </div>
    </body>

    </html>

